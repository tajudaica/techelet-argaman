---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="מדמה כיפה | תכלת וארגמן" description="נסי כיפות מהקולקציה על תמונה שלך — טכנולוגיה חדשה שמאפשרת לראות את הכיפה ממש עליך">
  <Header />

  <main class="sim-page">
    <div class="sim-header">
      <div class="container">
        <div class="eyebrow">חדשנות · טכנולוגיה</div>
        <h1 class="display-title sim-title">מדמה כיפה</h1>
        <div class="rule-gold" style="margin: 1rem auto"></div>
        <p class="sim-subtitle">העלי תמונה, בחרי כיפה מהקולקציה — וראי ממש איך היא נראית.</p>
      </div>
    </div>

    <div class="container sim-container">
      <div class="sim-layout">

        <!-- LEFT: Canvas -->
        <div class="sim-canvas-area">
          <div class="canvas-wrapper" id="canvas-wrapper">
            <canvas id="sim-canvas"></canvas>
            <div class="canvas-placeholder" id="canvas-placeholder">
              <div class="placeholder-icon">
                <svg viewBox="0 0 64 64" fill="none">
                  <rect x="4" y="12" width="56" height="40" rx="4" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="22" cy="27" r="5" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M4 44 L18 32 L28 40 L38 30 L60 44" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </div>
              <p class="placeholder-text">העלי תמונה להתחלה</p>
              <p class="placeholder-sub">JPG, PNG — תמונת פנים/ראש</p>
              <label class="btn btn-dark upload-btn-inner" for="photo-upload">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17,8 12,3 7,8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                העלי תמונה
              </label>
            </div>
            <!-- Kippah overlay on canvas -->
            <div class="kippah-layer" id="kippah-layer">
              <div class="kippah-display" id="kippah-display"></div>
              <div class="drag-hint" id="drag-hint">גרור להזזה · גלגלת להגדלה</div>
            </div>
          </div>

          <!-- Canvas controls -->
          <div class="canvas-controls" id="canvas-controls" style="display:none">
            <label class="ctrl-btn" for="photo-upload" title="החלף תמונה">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17,8 12,3 7,8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              החלף תמונה
            </label>
            <button class="ctrl-btn" id="btn-smaller" title="הקטן כיפה">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              הקטן
            </button>
            <button class="ctrl-btn" id="btn-bigger" title="הגדל כיפה">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              הגדל
            </button>
            <button class="ctrl-btn" id="btn-reset-pos" title="אפס מיקום">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
              אפס
            </button>
            <button class="ctrl-btn" id="btn-download" title="הורד תמונה">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              שמור
            </button>
          </div>
        </div>

        <!-- RIGHT: Kippah Selector -->
        <div class="sim-sidebar">
          <input type="file" id="photo-upload" accept="image/*" style="display:none" />

          <div class="sidebar-section">
            <h3 class="sidebar-title">בחרי סגנון כיפה</h3>
            <div class="kippah-options" id="kippah-options">

              <!-- Each option -->
              {[
                { id: 'pas',    label: 'עם פס', sub: 'מסורתי', color: '#5da0bd', color2: '#3d7a96', shape: 'pas' },
                { id: 'halak',  label: 'חלקה',  sub: 'אלגנטי', color: '#8B5E83', color2: '#6b4563', shape: 'halak' },
                { id: 'meq',    label: 'מקושקשת', sub: 'ייחודי', color: '#c9a96e', color2: '#a07840', shape: 'meq' },
                { id: 'frik',   label: 'פריק',   sub: 'מסורתי', color: '#4E8FA0', color2: '#2d6a7a', shape: 'frik' },
                { id: 'velvet', label: 'קטיפה',  sub: 'קלאסי',  color: '#1C2B4A', color2: '#0f1d33', shape: 'velvet' },
                { id: 'white',  label: 'לבנה',   sub: 'ניקיון', color: '#f0ece4', color2: '#d4c9b8', shape: 'white' },
              ].map(k => (
                <button class="kippah-option" data-id={k.id} data-color={k.color} data-color2={k.color2} data-shape={k.shape}>
                  <div class="kippah-preview-mini">
                    <svg viewBox="0 0 60 36" class="kippah-svg-mini">
                      <ellipse cx="30" cy="30" rx="28" ry="4" fill={k.color} opacity="0.2"/>
                      {k.shape === 'pas' && <>
                        <path d="M30 4 C10 4 2 22 2 30 L58 30 C58 22 50 4 30 4Z" fill={k.color}/>
                        <path d="M30 4 C10 4 2 22 2 26 L58 26 C58 22 50 4 30 4Z" fill={k.color2}/>
                      </>}
                      {k.shape === 'halak' && <path d="M30 4 C10 4 2 22 2 30 L58 30 C58 22 50 4 30 4Z" fill={k.color}/>}
                      {k.shape === 'meq' && <>
                        <path d="M30 4 C10 4 2 22 2 30 L58 30 C58 22 50 4 30 4Z" fill={k.color}/>
                        <circle cx="20" cy="20" r="2" fill={k.color2} opacity="0.7"/>
                        <circle cx="30" cy="14" r="2" fill={k.color2} opacity="0.7"/>
                        <circle cx="40" cy="20" r="2" fill={k.color2} opacity="0.7"/>
                        <circle cx="25" cy="25" r="1.5" fill={k.color2} opacity="0.7"/>
                        <circle cx="35" cy="25" r="1.5" fill={k.color2} opacity="0.7"/>
                      </>}
                      {k.shape === 'frik' && <>
                        <path d="M30 4 C10 4 2 22 2 30 L58 30 C58 22 50 4 30 4Z" fill={k.color}/>
                        {[2,6,10,14,18,22,26,30,34,38,42,46,50,54].map(x => (
                          <line x1={x} y1="30" x2={x} y2="34" stroke={k.color2} stroke-width="1.2"/>
                        ))}
                      </>}
                      {k.shape === 'velvet' && <path d="M30 4 C10 4 2 22 2 30 L58 30 C58 22 50 4 30 4Z" fill={k.color}/>}
                      {k.shape === 'white' && <>
                        <path d="M30 4 C10 4 2 22 2 30 L58 30 C58 22 50 4 30 4Z" fill={k.color} stroke={k.color2} stroke-width="0.5"/>
                      </>}
                    </svg>
                  </div>
                  <div class="kippah-option-info">
                    <span class="kippah-option-name">{k.label}</span>
                    <span class="kippah-option-sub">{k.sub}</span>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <div class="sidebar-section" id="color-section" style="display:none">
            <h3 class="sidebar-title">בחרי צבע</h3>
            <div class="color-swatches" id="color-swatches">
              {[
                '#5da0bd','#4E8FA0','#3d7a96',
                '#8B5E83','#6b4563','#9b3a6a',
                '#c9a96e','#B8933A','#a07840',
                '#2E7D52','#4a8c62','#1C5E3A',
                '#1C2B4A','#2d3f6a','#0f1d33',
                '#c94a4a','#a03030','#8B2020',
                '#f0ece4','#e8ddd0','#d4c9b8',
                '#1C1410','#2E2218','#4a3828',
              ].map(c => (
                <button class="color-swatch" data-color={c} style={`background: ${c}; border: 2px solid ${c === '#f0ece4' ? '#c4b5a5' : c}`} title={c}></button>
              ))}
            </div>
          </div>

          <div class="sidebar-section">
            <h3 class="sidebar-title">גודל כיפה</h3>
            <div class="size-slider-wrap">
              <label class="size-label">קטן</label>
              <input type="range" id="size-slider" min="60" max="220" value="120" class="size-slider" />
              <label class="size-label">גדול</label>
            </div>
          </div>

          <div class="sidebar-section" id="order-section" style="display:none">
            <div class="order-prompt">
              <p>מצאת כיפה שאהבת? נשמח ליצור עבורך!</p>
              <a href="/#contact" class="btn btn-dark" style="width:100%; justify-content:center; margin-top:1rem">להזמנה ←</a>
              <a href="https://wa.me/972500000000" class="btn btn-outline" style="width:100%; justify-content:center; margin-top:0.6rem; font-size:0.78rem" target="_blank">WhatsApp מהיר</a>
            </div>
          </div>

          <div class="sim-instructions">
            <div class="instr-title">איך משתמשים?</div>
            <div class="instr-steps">
              <div class="instr-step"><span class="step-num">1</span><span>העלי תמונת פנים/ראש</span></div>
              <div class="instr-step"><span class="step-num">2</span><span>בחרי סגנון וצבע כיפה</span></div>
              <div class="instr-step"><span class="step-num">3</span><span>גרגרי את הכיפה על הראש</span></div>
              <div class="instr-step"><span class="step-num">4</span><span>שמרי את התמונה ושלחי לנו</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .sim-page { padding-top: 110px; min-height: 100vh; }

  .sim-header {
    background: var(--ink);
    padding: 4rem 0 3.5rem;
    text-align: center;
  }
  .sim-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--parchment);
    margin: 0.5rem 0;
  }
  .sim-subtitle {
    font-size: 0.95rem;
    font-weight: 300;
    color: rgba(248,244,238,0.5);
    margin-top: 1rem;
    letter-spacing: 0.04em;
  }
  .sim-header .eyebrow { color: var(--gold-light); }

  .sim-container { padding: 3rem 2.5rem 5rem; }
  .sim-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    align-items: start;
  }

  /* Canvas */
  .canvas-wrapper {
    background: var(--parchment-2);
    border: 1px solid var(--border);
    position: relative;
    min-height: 480px;
    overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  #sim-canvas {
    display: none;
    max-width: 100%;
    touch-action: none;
  }
  .canvas-placeholder {
    text-align: center;
    padding: 4rem 2rem;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
  }
  .placeholder-icon { color: var(--border-dark); }
  .placeholder-icon svg { width: 64px; height: 64px; }
  .placeholder-text { font-family: var(--ff-display); font-size: 1.2rem; color: var(--ink-light); font-style: italic; }
  .placeholder-sub { font-size: 0.78rem; color: var(--border-dark); font-weight: 300; margin-top: -0.5rem; }

  .kippah-layer {
    position: absolute; inset: 0;
    pointer-events: none;
    display: none;
  }
  .kippah-layer.active {
    display: block;
    pointer-events: all;
  }
  .kippah-display {
    position: absolute;
    cursor: grab;
    user-select: none;
    transition: filter 0.2s;
  }
  .kippah-display:active { cursor: grabbing; }
  .kippah-display svg { display: block; }

  .drag-hint {
    position: absolute;
    bottom: 12px; left: 50%;
    transform: translateX(-50%);
    background: rgba(28,20,16,0.6);
    color: rgba(248,244,238,0.7);
    font-size: 0.7rem;
    padding: 0.3rem 0.8rem;
    letter-spacing: 0.06em;
    pointer-events: none;
    backdrop-filter: blur(4px);
    transition: opacity 0.4s;
  }
  .drag-hint.hidden { opacity: 0; }

  .canvas-controls {
    display: flex; gap: 0.6rem; flex-wrap: wrap;
    margin-top: 1rem;
  }
  .ctrl-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--parchment-2);
    border: 1px solid var(--border-dark);
    color: var(--ink-light);
    font-size: 0.75rem;
    padding: 0.45rem 0.9rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--ff-body);
  }
  .ctrl-btn:hover { background: var(--ink); color: var(--parchment); border-color: var(--ink); }

  /* Sidebar */
  .sim-sidebar {
    display: flex; flex-direction: column; gap: 0;
    border: 1px solid var(--border);
    background: var(--parchment);
  }
  .sidebar-section {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .sidebar-section:last-child { border-bottom: none; }
  .sidebar-title {
    font-family: var(--ff-display);
    font-size: 1rem; font-weight: 500;
    color: var(--ink); margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .kippah-options {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;
  }
  .kippah-option {
    display: flex; align-items: center; gap: 0.6rem;
    background: var(--parchment-2);
    border: 1px solid var(--border);
    padding: 0.6rem 0.7rem;
    cursor: pointer;
    transition: all 0.2s;
    text-align: right;
    width: 100%;
  }
  .kippah-option:hover { border-color: var(--gold); }
  .kippah-option.selected { border-color: var(--gold); background: var(--gold-pale); }
  .kippah-preview-mini { width: 48px; height: 30px; flex-shrink: 0; }
  .kippah-svg-mini { width: 100%; height: 100%; }
  .kippah-option-name { display: block; font-size: 0.8rem; font-weight: 500; color: var(--ink); }
  .kippah-option-sub { display: block; font-size: 0.68rem; color: var(--ink-light); font-weight: 300; }

  .color-swatches {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
  }
  .color-swatch {
    width: 26px; height: 26px;
    cursor: pointer;
    transition: transform 0.15s, outline 0.15s;
    outline: 2px solid transparent;
    outline-offset: 2px;
  }
  .color-swatch:hover { transform: scale(1.15); }
  .color-swatch.selected { outline-color: var(--gold); }

  .size-slider-wrap {
    display: flex; align-items: center; gap: 0.8rem;
  }
  .size-label { font-size: 0.72rem; color: var(--ink-light); flex-shrink: 0; }
  .size-slider {
    flex: 1;
    height: 2px;
    background: var(--border-dark);
    outline: none;
    border: none;
    cursor: pointer;
    accent-color: var(--gold);
  }

  .order-prompt {
    background: var(--parchment-2);
    border: 1px solid var(--border);
    padding: 1.2rem;
    text-align: center;
  }
  .order-prompt p { font-size: 0.82rem; color: var(--ink-light); font-weight: 300; line-height: 1.7; }

  .sim-instructions {
    padding: 1.2rem 1.5rem;
    background: var(--parchment-3);
  }
  .instr-title { font-size: 0.75rem; font-weight: 500; color: var(--ink-light); letter-spacing: 0.1em; margin-bottom: 0.8rem; }
  .instr-steps { display: flex; flex-direction: column; gap: 0.5rem; }
  .instr-step { display: flex; align-items: center; gap: 0.6rem; font-size: 0.78rem; color: var(--ink-light); font-weight: 300; }
  .step-num {
    width: 20px; height: 20px;
    background: var(--gold); color: #fff;
    border-radius: 50%;
    font-size: 0.65rem; font-weight: 500;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .sim-layout { grid-template-columns: 1fr; }
    .kippah-options { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
// ─── Kippah Simulator Logic ───────────────────────────────────────

const canvas = document.getElementById('sim-canvas') as HTMLCanvasElement;
const ctx = canvas?.getContext('2d');
const wrapper = document.getElementById('canvas-wrapper')!;
const placeholder = document.getElementById('canvas-placeholder')!;
const kippahLayer = document.getElementById('kippah-layer')!;
const kippahDisplay = document.getElementById('kippah-display')!;
const dragHint = document.getElementById('drag-hint')!;
const controls = document.getElementById('canvas-controls')!;
const orderSection = document.getElementById('order-section')!;
const colorSection = document.getElementById('color-section')!;

let kippahState = {
  shape: 'halak',
  color: '#5da0bd',
  color2: '#3d7a96',
  size: 120,
  x: 50,
  y: 30,
  selected: false,
};

// ─── Photo upload ─────────────────────────────────────────────────
const photoInput = document.getElementById('photo-upload') as HTMLInputElement;
photoInput.addEventListener('change', (e) => {
  const file = (e.target as HTMLInputElement).files?.[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (ev) => {
    const img = new Image();
    img.onload = () => {
      const maxW = wrapper.clientWidth;
      const maxH = Math.max(480, window.innerHeight * 0.65);
      const ratio = Math.min(maxW / img.width, maxH / img.height, 1);
      canvas.width = img.width * ratio;
      canvas.height = img.height * ratio;
      ctx?.drawImage(img, 0, 0, canvas.width, canvas.height);

      canvas.style.display = 'block';
      placeholder.style.display = 'none';
      kippahLayer.classList.add('active');
      controls.style.display = 'flex';
      orderSection.style.display = 'block';

      // Default kippah position: top-center
      kippahState.x = canvas.width / 2;
      kippahState.y = canvas.height * 0.22;
      renderKippah();
    };
    img.src = ev.target?.result as string;
  };
  reader.readAsDataURL(file);
});

// ─── Render kippah SVG overlay ────────────────────────────────────
function renderKippah() {
  const s = kippahState;
  const w = s.size * 1.7;
  const h = s.size;
  const x = s.x - w / 2;
  const y = s.y - h * 0.65;

  let innerSVG = '';
  if (s.shape === 'pas') {
    innerSVG = `
      <path d="M${w/2} 4 C${w*0.12} 4 2 ${h*0.7} 2 ${h} L${w-2} ${h} C${w-2} ${h*0.7} ${w*0.88} 4 ${w/2} 4Z" fill="${s.color}"/>
      <path d="M${w/2} 4 C${w*0.12} 4 2 ${h*0.7} 2 ${h*0.8} L${w-2} ${h*0.8} C${w-2} ${h*0.7} ${w*0.88} 4 ${w/2} 4Z" fill="${s.color2}"/>
    `;
  } else if (s.shape === 'meq') {
    const dots = Array.from({length:10}, (_,i) => {
      const px = (w * 0.2) + (i % 5) * (w * 0.15);
      const py = (h * 0.3) + Math.floor(i/5) * (h * 0.25);
      return `<circle cx="${px}" cy="${py}" r="${s.size*0.022}" fill="${s.color2}" opacity="0.75"/>`;
    }).join('');
    innerSVG = `
      <path d="M${w/2} 4 C${w*0.12} 4 2 ${h*0.7} 2 ${h} L${w-2} ${h} C${w-2} ${h*0.7} ${w*0.88} 4 ${w/2} 4Z" fill="${s.color}"/>
      ${dots}
    `;
  } else if (s.shape === 'frik') {
    const fringe = Array.from({length:18}, (_,i) => {
      const fx = (i / 17) * (w - 4) + 2;
      return `<line x1="${fx}" y1="${h}" x2="${fx}" y2="${h + h*0.12}" stroke="${s.color2}" stroke-width="1.3"/>`;
    }).join('');
    innerSVG = `
      <path d="M${w/2} 4 C${w*0.12} 4 2 ${h*0.7} 2 ${h} L${w-2} ${h} C${w-2} ${h*0.7} ${w*0.88} 4 ${w/2} 4Z" fill="${s.color}"/>
      ${fringe}
    `;
  } else {
    // halak, velvet, white, default
    innerSVG = `
      <path d="M${w/2} 4 C${w*0.12} 4 2 ${h*0.7} 2 ${h} L${w-2} ${h} C${w-2} ${h*0.7} ${w*0.88} 4 ${w/2} 4Z" fill="${s.color}" ${s.color === '#f0ece4' ? `stroke="${s.color2}" stroke-width="1"` : ''}/>
    `;
  }

  const svg = `<svg width="${w}" height="${h + h*0.15}" viewBox="0 0 ${w} ${h + h*0.15}" xmlns="http://www.w3.org/2000/svg" style="filter: drop-shadow(0 3px 8px rgba(0,0,0,0.25)) drop-shadow(0 1px 2px rgba(0,0,0,0.15));">
    <ellipse cx="${w/2}" cy="${h}" rx="${w/2 - 2}" ry="${h*0.06}" fill="${s.color}" opacity="0.35"/>
    ${innerSVG}
  </svg>`;

  kippahDisplay.innerHTML = svg;
  kippahDisplay.style.left = `${x}px`;
  kippahDisplay.style.top = `${y}px`;
  kippahDisplay.style.width = `${w}px`;
  kippahDisplay.style.height = `${h + h*0.15}px`;
}

// ─── Drag ─────────────────────────────────────────────────────────
let dragging = false;
let dragOffX = 0, dragOffY = 0;
let hintTimer: ReturnType<typeof setTimeout>;

function showHint() {
  dragHint.classList.remove('hidden');
  clearTimeout(hintTimer);
  hintTimer = setTimeout(() => dragHint.classList.add('hidden'), 2000);
}

kippahDisplay.addEventListener('pointerdown', (e) => {
  dragging = true;
  const rect = canvas.getBoundingClientRect();
  dragOffX = e.clientX - rect.left - kippahState.x;
  dragOffY = e.clientY - rect.top - kippahState.y;
  kippahDisplay.setPointerCapture(e.pointerId);
  dragHint.classList.add('hidden');
});
kippahDisplay.addEventListener('pointermove', (e) => {
  if (!dragging) return;
  const rect = canvas.getBoundingClientRect();
  kippahState.x = e.clientX - rect.left - dragOffX;
  kippahState.y = e.clientY - rect.top - dragOffY;
  renderKippah();
});
kippahDisplay.addEventListener('pointerup', () => { dragging = false; });

// Wheel zoom
wrapper.addEventListener('wheel', (e) => {
  if (!kippahLayer.classList.contains('active')) return;
  e.preventDefault();
  kippahState.size = Math.max(40, Math.min(280, kippahState.size - e.deltaY * 0.3));
  document.getElementById('size-slider')!.setAttribute('value', String(kippahState.size));
  (document.getElementById('size-slider') as HTMLInputElement).value = String(kippahState.size);
  renderKippah();
  showHint();
}, { passive: false });

// ─── Kippah options ───────────────────────────────────────────────
document.querySelectorAll('.kippah-option').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.kippah-option').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    kippahState.shape = btn.getAttribute('data-shape') || 'halak';
    kippahState.color = btn.getAttribute('data-color') || '#5da0bd';
    kippahState.color2 = btn.getAttribute('data-color2') || '#3d7a96';
    colorSection.style.display = 'block';
    if (kippahLayer.classList.contains('active')) {
      renderKippah();
      showHint();
    }
    // First selection → prompt to upload if no image
    if (!kippahLayer.classList.contains('active')) {
      placeholder.querySelector('.upload-btn-inner')?.classList.add('pulse');
    }
  });
});

// ─── Color swatches ───────────────────────────────────────────────
document.querySelectorAll('.color-swatch').forEach(sw => {
  sw.addEventListener('click', () => {
    document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
    sw.classList.add('selected');
    const c = sw.getAttribute('data-color') || '#5da0bd';
    kippahState.color = c;
    // Darken for secondary
    kippahState.color2 = c;
    if (kippahLayer.classList.contains('active')) renderKippah();
  });
});

// ─── Size slider ──────────────────────────────────────────────────
const sizeSlider = document.getElementById('size-slider') as HTMLInputElement;
sizeSlider.addEventListener('input', () => {
  kippahState.size = parseInt(sizeSlider.value);
  if (kippahLayer.classList.contains('active')) renderKippah();
});

// ─── Control buttons ─────────────────────────────────────────────
document.getElementById('btn-smaller')?.addEventListener('click', () => {
  kippahState.size = Math.max(40, kippahState.size - 12);
  sizeSlider.value = String(kippahState.size);
  renderKippah();
});
document.getElementById('btn-bigger')?.addEventListener('click', () => {
  kippahState.size = Math.min(280, kippahState.size + 12);
  sizeSlider.value = String(kippahState.size);
  renderKippah();
});
document.getElementById('btn-reset-pos')?.addEventListener('click', () => {
  kippahState.x = canvas.width / 2;
  kippahState.y = canvas.height * 0.22;
  renderKippah();
  showHint();
});

// ─── Download merged image ─────────────────────────────────────────
document.getElementById('btn-download')?.addEventListener('click', () => {
  const offscreen = document.createElement('canvas');
  offscreen.width = canvas.width;
  offscreen.height = canvas.height;
  const oc = offscreen.getContext('2d')!;

  // Draw base photo
  oc.drawImage(canvas, 0, 0);

  // Draw kippah SVG onto canvas
  const svgStr = kippahDisplay.innerHTML;
  const blob = new Blob([`<svg xmlns="http://www.w3.org/2000/svg" width="${kippahDisplay.clientWidth}" height="${kippahDisplay.clientHeight}">${svgStr}</svg>`], {type: 'image/svg+xml'});
  const url = URL.createObjectURL(blob);
  const img = new Image();
  img.onload = () => {
    const kx = parseFloat(kippahDisplay.style.left);
    const ky = parseFloat(kippahDisplay.style.top);
    oc.drawImage(img, kx, ky, kippahDisplay.clientWidth, kippahDisplay.clientHeight);
    URL.revokeObjectURL(url);
    const a = document.createElement('a');
    a.download = 'techelet-argaman-kippah.png';
    a.href = offscreen.toDataURL('image/png');
    a.click();
  };
  img.src = url;
});

// Initial hint
showHint();
</script>
