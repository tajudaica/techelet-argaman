<style>
  #site-header {
    position: fixed;
    top: 0; right: 0; left: 0;
    z-index: 100;
    transition: background 0.4s, box-shadow 0.4s;
  }
  #site-header.scrolled {
    background: rgba(248,244,238,0.97);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 var(--border);
  }

  .topbar {
    background: var(--ink);
    color: rgba(248,244,238,0.55);
    text-align: center;
    padding: 0.55rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    font-weight: 300;
    transition: height 0.3s, opacity 0.3s;
  }
  #site-header.scrolled .topbar { display: none; }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    padding: 0 2.5rem;
    max-width: var(--max-w);
    margin: 0 auto;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }
  .logo img { width: 52px; height: 52px; }
  .logo-text { line-height: 1.15; }
  .logo-name {
    font-family: var(--ff-display);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  .logo-tagline {
    font-size: 0.62rem;
    color: var(--ink-light);
    letter-spacing: 0.12em;
    font-weight: 300;
  }

  /* Desktop Nav */
  .desktop-nav { display: flex; align-items: center; gap: 2.4rem; }
  .desktop-nav a {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--ink-light);
    letter-spacing: 0.06em;
    position: relative;
    padding-bottom: 3px;
    transition: color 0.2s;
  }
  .desktop-nav a::after {
    content: '';
    position: absolute;
    bottom: 0; right: 0;
    width: 0; height: 1px;
    background: var(--gold);
    transition: width 0.3s var(--ease);
  }
  .desktop-nav a:hover { color: var(--ink); }
  .desktop-nav a:hover::after { width: 100%; }

  /* Header actions */
  .header-actions { display: flex; align-items: center; gap: 1rem; }
  .header-actions a {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink-light);
    transition: color 0.2s;
  }
  .header-actions a:hover { color: var(--ink); }
  .cart-link { position: relative; }
  .cart-count {
    position: absolute;
    top: -6px; left: -6px;
    width: 16px; height: 16px;
    background: var(--gold);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 500;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    display: block;
    width: 22px; height: 1.5px;
    background: var(--ink);
    transition: all 0.3s;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile Nav */
  #nav-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(28,20,16,0.4);
    z-index: 150;
    opacity: 0;
    transition: opacity 0.3s;
  }
  #nav-overlay.open { display: block; opacity: 1; }

  #mobile-nav {
    position: fixed;
    top: 0; right: -100%;
    height: 100%;
    width: min(320px, 80vw);
    background: var(--parchment);
    z-index: 200;
    padding: 5rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: right 0.4s var(--ease);
    border-left: 1px solid var(--border);
  }
  #mobile-nav.open { right: 0; }
  #mobile-nav a {
    display: block;
    font-family: var(--ff-display);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--ink);
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.02em;
  }
  #mobile-nav a:first-child { border-top: 1px solid var(--border); }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .hamburger { display: flex; }
    .header-inner { padding: 0 1.25rem; }
  }
</style>

<div id="nav-overlay"></div>

<header id="site-header">
  <div class="topbar">
    ✡ &nbsp; כל הפריטים בעבודת יד &nbsp;|&nbsp; משלוח מהיר לכל הארץ &nbsp;|&nbsp; הזמנות אישיות בברכה &nbsp; ✡
  </div>
  <div class="header-inner">
    <a class="logo" href="/">
      <img src="/logo.svg" alt="תכלת וארגמן לוגו" width="52" height="52" />
      <div class="logo-text">
        <div class="logo-name">תכלת וארגמן</div>
        <div class="logo-tagline">כיפות ואביזרים בעבודת יד</div>
      </div>
    </a>

    <nav class="desktop-nav">
      <a href="/#products">הקולקציה</a>
      <a href="/#categories">קטגוריות</a>
      <a href="/simulator">מדמה כיפה</a>
      <a href="/#about">אודות</a>
      <a href="/#contact">צרי קשר</a>
    </nav>

    <div class="header-actions">
      <a href="/simulator" style="font-size:0.72rem;letter-spacing:0.08em;border:1px solid var(--border-dark);padding:0.4rem 0.9rem;transition:all 0.2s">מדמה כיפה</a>
      <button id="hamburger" class="hamburger" aria-label="תפריט">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<nav id="mobile-nav">
  <a href="/">בית</a>
  <a href="/#products">הקולקציה</a>
  <a href="/#categories">קטגוריות</a>
  <a href="/simulator">מדמה כיפה</a>
  <a href="/#about">אודות</a>
  <a href="/#contact">צרי קשר</a>
</nav>
