---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { num: '01', name: 'כיפות עם פס', desc: 'עיצוב מסורתי עם פס דקורטיבי. כל כיפה – יחידת אמנות בפני עצמה, בגוונים אינסופיים.' },
  { num: '02', name: 'כיפות חלקות', desc: 'קווים נקיים ואלגנטיים. הידור שקט ומכובד שמתאים לכל מי שמעדיף סגנון.' },
  { num: '03', name: 'כיפות מקושקשות', desc: 'קישוטים ייחודיים עם אישיות. כל כיפה מספרת סיפור משלה.' },
  { num: '04', name: 'כיפות פריק', desc: 'פרוקה מסורתית בעבודת יד מושקעת. אלגנטיות ישנת-עולם, תפורה מחדש.' },
  { num: '05', name: 'כיסויי פלטה וחלה', desc: 'לשולחן השבת והחג. כיסויים יפים שמוסיפים הדר לכל סעודה קדושה.' },
  { num: '06', name: 'כיסויי טלית ותפילין', desc: 'לאביזרי המצווה היקרים. כיסוי מכובד לדברים הקדושים ביותר בחייך.' },
];

const products = [
  { name: 'כיפה עם פס', category: 'כיפות', price: '65', badge: 'נבחר', emoji: '🧢', bg: '#EEF5F8' },
  { name: 'כיפה חלקה',  category: 'כיפות', price: '55', badge: '', emoji: '🎨', bg: '#F5F0F0' },
  { name: 'כיפה מקושקשת', category: 'כיפות', price: '80', badge: 'מיוחד', emoji: '🖌️', bg: '#F0F5F0' },
  { name: 'כיפת פריק',  category: 'כיפות', price: '90', badge: '', emoji: '✨', bg: '#F8F3EC' },
  { name: 'כיסוי פלטה וחלה', category: 'כיסויים', price: '120', badge: 'חדש', emoji: '🍞', bg: '#F3F0F8' },
  { name: 'כיסוי טלית ותפילין', category: 'כיסויים', price: '150', badge: '', emoji: '🕍', bg: '#EEF5F8' },
  { name: 'סט כיפות לאירוע', category: 'סטים', price: '350', badge: 'פופולרי', emoji: '🎁', bg: '#F8F5EC' },
  { name: 'כיפה בעיצוב אישי', category: 'מותאם', price: '100', badge: '', emoji: '⭐', bg: '#F5F0F0' },
];
---
<Layout>
  <Header />

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-bg-pattern"></div>
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="eyebrow hero-eyebrow">בוטיק יודאיקה מהודר · עבודת יד</div>
        <h1 class="display-title hero-h1">
          כיפות<br>
          <em>בעבודת יד</em><br>
          לרגעים הקדושים
        </h1>
        <p class="hero-desc">
          כל פריט נוצר מאהבה ומסירות.<br>
          הידור מצווה אמיתי — לכל יום, לכל שבת, לכל אירוע.
        </p>
        <div class="hero-actions">
          <a href="/#products" class="btn btn-dark">לקולקציה המלאה</a>
          <a href="/#contact" class="btn btn-outline">הזמנה אישית</a>
        </div>
        <div class="hero-trust">
          <div class="trust-item">
            <span class="trust-dot"></span>
            עבודת יד 100%
          </div>
          <div class="trust-item">
            <span class="trust-dot"></span>
            עיצוב אישי
          </div>
          <div class="trust-item">
            <span class="trust-dot"></span>
            משלוח לכל הארץ
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-ring hero-ring-1"></div>
        <div class="hero-ring hero-ring-2"></div>
        <div class="hero-ring hero-ring-3"></div>
        <div class="hero-center">
          <div class="hero-orn top">✡</div>
          <div class="hero-brand-block">
            <span class="hero-brand-word">תכלת</span>
            <span class="hero-brand-amp">וארגמן</span>
            <span class="hero-brand-word accent">כיפות</span>
          </div>
          <div class="hero-orn bottom">✡</div>
          <div class="hero-tagline-small">עבודת יד · הידור מצווה</div>
        </div>
      </div>
    </div>
    <div class="hero-scroll-indicator">
      <div class="scroll-label">גלול</div>
      <div class="scroll-line-anim"></div>
    </div>
  </section>

  <!-- ═══ STRIP ═══ -->
  <div class="value-strip">
    <div class="container value-strip-inner">
      {['עבודת יד מלאה', 'הידור מצווה אמיתי', 'עיצוב אישי לפי בחירה', 'משלוח לכל הארץ', 'מענה תוך 24 שעות'].map((v, i) => (
        <>
          <div class="strip-item">{v}</div>
          {i < 4 && <div class="strip-sep">◆</div>}
        </>
      ))}
    </div>
  </div>

  <!-- ═══ CATEGORIES ═══ -->
  <section class="section" id="categories">
    <div class="container">
      <div class="section-header reveal">
        <div class="eyebrow">הקולקציה שלנו</div>
        <h2 class="display-title" style="font-size: clamp(2.2rem,4vw,3rem); margin: 0.6rem 0 1rem">פריטים לכל רגע מיוחד</h2>
        <div class="rule-gold" style="margin: 0 auto 1rem"></div>
        <p class="section-sub">כיפות, כיסויים ואביזרים — כל פריט נוצר בקפידה ובאהבה, ומחכה לבעליו הנכון</p>
      </div>

      <div class="cats-grid">
        {categories.map((cat, i) => (
          <a href={`/#products`} class="cat-card reveal" style={`transition-delay: ${i * 0.08}s`}>
            <div class="cat-num">{cat.num}</div>
            <div class="cat-rule"></div>
            <h3 class="cat-name">{cat.name}</h3>
            <p class="cat-desc">{cat.desc}</p>
            <div class="cat-arrow">←</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PRODUCTS ═══ -->
  <section class="section products-section" id="products">
    <div class="container">
      <div class="section-header reveal" style="text-align:center; margin-bottom:3.5rem">
        <div class="eyebrow">נבחרת הפריטים</div>
        <h2 class="display-title" style="font-size: clamp(2.2rem,4vw,3rem); margin: 0.6rem 0 1rem; color:#F8F4EE">פריטים מהקולקציה</h2>
        <div class="rule-gold" style="margin: 0 auto"></div>
      </div>
      <div class="products-grid">
        {products.map((p, i) => (
          <article class="product-card reveal" style={`transition-delay: ${i * 0.06}s`}>
            <div class="product-img" style={`background: ${p.bg}`}>
              <span class="product-emoji">{p.emoji}</span>
              {p.badge && <div class="product-badge">{p.badge}</div>}
              <div class="product-overlay">
                <span>לפרטים</span>
              </div>
            </div>
            <div class="product-body">
              <div class="product-cat">{p.category}</div>
              <h3 class="product-name">{p.name}</h3>
              <div class="product-footer">
                <div class="product-price">₪{p.price} <small>ומעלה</small></div>
                <a href="/#contact" class="product-order-btn">הזמינו</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div style="text-align:center; margin-top:3rem">
        <a href="/#contact" class="btn btn-outline" style="color:#F8F4EE; border-color:rgba(248,244,238,0.25)">לכל הקולקציה ←</a>
      </div>
    </div>
  </section>

  <!-- ═══ SIMULATOR CTA ═══ -->
  <section class="sim-cta-section">
    <div class="container sim-cta-inner">
      <div class="sim-cta-text reveal">
        <div class="eyebrow">חדש!</div>
        <h2 class="display-title" style="font-size: clamp(1.8rem,3.5vw,2.8rem); margin: 0.5rem 0 1rem">מדמה כיפה — ראי אותה עליך</h2>
        <p style="font-size:0.95rem; font-weight:300; color:var(--ink-light); line-height:1.8; margin-bottom:2rem">
          העלי תמונה, בחרי כיפה מהקולקציה — וראי ממש כמה היא תיראה יפה.<br>
          טכנולוגיה חדשה שמאפשרת לדמות את הכיפה על ראש.
        </p>
        <a href="/simulator" class="btn btn-dark">לסימולטור ←</a>
      </div>
      <div class="sim-cta-visual reveal" style="transition-delay:0.15s">
        <div class="sim-preview-box">
          <div class="sim-preview-head">
            <div class="sim-head-circle"></div>
            <div class="sim-kippah-preview">🧢</div>
          </div>
          <div class="sim-preview-label">מדמה כיפה אינטראקטיבי</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT ═══ -->
  <section class="section about-section" id="about">
    <div class="container about-grid">
      <div class="about-left reveal">
        <div class="about-quote-card">
          <div class="about-qmark">"</div>
          <p class="about-quote-text">
            כל תפר הוא חלק מסיפור. כל צבע — בחירה מכוונת.
            כל כיפה — מתנה מהלב לאדם מיוחד.
          </p>
          <div class="about-quote-attr">— תכלת וארגמן</div>
        </div>
        <div class="about-stats">
          <div class="stat-box">
            <div class="stat-number">100%</div>
            <div class="stat-label">עבודת יד</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">∞</div>
            <div class="stat-label">אפשרויות צבע</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">24h</div>
            <div class="stat-label">זמן מענה</div>
          </div>
        </div>
      </div>
      <div class="about-right reveal" style="transition-delay:0.15s">
        <div class="eyebrow">אודות</div>
        <h2 class="display-title about-title">מאהבה<br><em>ומסירות</em></h2>
        <div class="rule-gold" style="margin: 1.2rem 0"></div>
        <p class="about-text">
          תכלת וארגמן היא בוטיק ייחודי לכיפות ואביזרים יהודיים בעבודת יד.
          אנחנו מאמינות שהידור מצווה מתחיל בפרטים הקטנים — בבחירת הצבע הנכון,
          בתפר המדויק, בפריט שנוצר עבורך ולא לאף אחד אחר.
        </p>
        <p class="about-text">
          כל פריט מותאם אישית לפי צבע, גודל ועיצוב — כי אתם ראויים
          לדבר שנוצר במיוחד עבורכם.
        </p>
        <div class="about-features">
          {[
            ['עבודת יד מלאה', 'כל פריט ייחודי ומיוחד'],
            ['עיצוב אישי', 'צבע, גודל וסגנון לבחירה'],
            ['מתנה מושלמת', 'לבר מצווה, חתונה ועוד'],
            ['משלוח לכל הארץ', 'מהיר, עטוף ומהודר'],
          ].map(([title, sub]) => (
            <div class="about-feat">
              <div class="feat-diamond">◆</div>
              <div>
                <strong class="feat-title">{title}</strong>
                <span class="feat-sub">{sub}</span>
              </div>
            </div>
          ))}
        </div>
        <a href="/#contact" class="btn btn-dark" style="margin-top:2rem">לשיחת הזמנה ←</a>
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="section testi-section">
    <div class="container">
      <div class="section-header reveal" style="text-align:center; margin-bottom:3.5rem">
        <div class="eyebrow">לקוחות כותבות</div>
        <h2 class="display-title" style="font-size: clamp(2rem,3.5vw,2.8rem); margin: 0.5rem 0 1rem">דברים שהרגישו</h2>
        <div class="rule-gold" style="margin: 0 auto"></div>
      </div>
      <div class="testi-grid">
        {[
          { text: '"הכיפה הגיעה עטופה יפה כל כך, כמו מתנה אמיתית. האיכות מדהימה — ברור שנעשה מאהבה."', name: 'רבקה כהן', city: 'ירושלים', init: 'ר' },
          { text: '"כיסוי הטלית שהזמנתי לבר מצווה של הבן — קיבלתי בדמעות. עבודה של אמנות, לא רק מוצר."', name: 'דינה לוי', city: 'בני ברק', init: 'ד' },
          { text: '"ענו לי מהר, הקשיבו לדיוק מה שרציתי, ויצא בדיוק כמו שחלמתי. ממליצה בחום לכולן."', name: 'שרה אברהם', city: 'תל אביב', init: 'ש' },
        ].map((t, i) => (
          <div class="testi-card reveal" style={`transition-delay: ${i * 0.1}s`}>
            <div class="testi-stars">★★★★★</div>
            <p class="testi-text">{t.text}</p>
            <div class="testi-author">
              <div class="testi-avatar">{t.init}</div>
              <div>
                <strong class="testi-name">{t.name}</strong>
                <span class="testi-city">{t.city}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA DARK ═══ -->
  <div class="dark-cta">
    <div class="container dark-cta-inner">
      <div class="dark-cta-orn">✡</div>
      <div class="dark-cta-text reveal">
        <h2 class="display-title" style="font-size: clamp(1.8rem,3.5vw,2.6rem); color:#F8F4EE; margin-bottom:0.8rem">
          יש לכם אירוע מיוחד?
        </h2>
        <p style="font-size:0.9rem; color:rgba(248,244,238,0.5); font-weight:300; line-height:1.8">
          בר מצווה, חתן, ברית — אנחנו שמחות ליצור עבורכם פריטים<br>בעיצוב אישי, בכמויות, בצבעים שתבחרו.
        </p>
      </div>
      <a href="/#contact" class="btn btn-gold">לדבר אתנו ←</a>
    </div>
  </div>

  <!-- ═══ CONTACT ═══ -->
  <section class="section contact-section" id="contact">
    <div class="container">
      <div class="section-header reveal" style="text-align:center; margin-bottom:3.5rem">
        <div class="eyebrow">נשמח לשמוע</div>
        <h2 class="display-title" style="font-size: clamp(2rem,3.5vw,2.8rem); margin: 0.5rem 0 1rem">צרי קשר</h2>
        <div class="rule-gold" style="margin: 0 auto 0.8rem"></div>
        <p class="section-sub">להזמנות, שאלות ועיצוב אישי — אנחנו כאן בשבילכם</p>
      </div>

      <div class="contact-grid">
        <div class="contact-info reveal">
          <h3 class="contact-info-title">פרטי יצירת קשר</h3>
          {[
            { icon: 'phone', label: 'טלפון / WhatsApp', sub: 'שלחו הודעה ונחזור אליכם מהר' },
            { icon: 'mail', label: 'אימייל', sub: 'techelesargaman@gmail.com' },
            { icon: 'clock', label: 'זמן מענה', sub: 'עד 24 שעות — תמיד' },
            { icon: 'truck', label: 'משלוחים', sub: 'לכל רחבי הארץ' },
          ].map(c => (
            <div class="contact-item">
              <div class="contact-icon">
                {c.icon === 'phone' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.82 19.79 19.79 0 01.01 1.22 2 2 0 012 .01h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6z"/></svg>}
                {c.icon === 'mail' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>}
                {c.icon === 'clock' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>}
                {c.icon === 'truck' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="1" y="3" width="15" height="13"/><polygon points="16,8 20,8 23,11 23,16 16,16 16,8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>}
              </div>
              <div>
                <strong class="contact-label">{c.label}</strong>
                <span class="contact-sub">{c.sub}</span>
              </div>
            </div>
          ))}

          <a href="https://wa.me/972500000000" class="whatsapp-btn" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.004 2C6.484 2 2 6.484 2 12c0 1.771.463 3.433 1.27 4.877L2 22l5.235-1.273A9.96 9.96 0 0012.004 22C17.523 22 22 17.516 22 12S17.523 2 12.004 2zm0 18.18a8.175 8.175 0 01-4.16-1.136l-.3-.176-3.103.754.78-2.994-.196-.311A8.165 8.165 0 013.82 12c0-4.51 3.671-8.18 8.18-8.18 4.512 0 8.18 3.67 8.18 8.18s-3.668 8.18-8.176 8.18z"/></svg>
            שלחו הודעה ב-WhatsApp
          </a>
        </div>

        <form class="contact-form reveal" style="transition-delay:0.15s" id="contact-form">
          <div class="form-row-2">
            <div class="form-group">
              <label>שם מלא *</label>
              <input type="text" name="name" required placeholder="השם שלכם" />
            </div>
            <div class="form-group">
              <label>טלפון</label>
              <input type="tel" name="phone" placeholder="050-0000000" />
            </div>
          </div>
          <div class="form-group">
            <label>אימייל</label>
            <input type="email" name="email" placeholder="your@email.com" />
          </div>
          <div class="form-group">
            <label>פרטי הבקשה</label>
            <textarea name="message" rows="5" placeholder="ספרו לנו מה אתם מחפשים — סוג כיפה, צבע, גודל, כמות, אירוע..."></textarea>
          </div>
          <button type="submit" class="btn btn-dark form-btn">שלחי הודעה ←</button>
          <p class="form-success" id="form-success" style="display:none; color:#2d7a5a; margin-top:1rem; font-size:0.9rem;">✓ ההודעה נשלחה! נחזור אליכם בקרוב.</p>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 110px;
    padding-bottom: 5rem;
    position: relative;
    overflow: hidden;
  }
  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 78% 35%, rgba(78,143,160,0.07) 0%, transparent 55%),
      radial-gradient(circle at 15% 70%, rgba(184,147,58,0.06) 0%, transparent 50%);
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .hero-eyebrow { margin-bottom: 1.5rem; }
  .hero-h1 {
    font-size: clamp(3.5rem, 7vw, 6rem);
    margin-bottom: 1.8rem;
